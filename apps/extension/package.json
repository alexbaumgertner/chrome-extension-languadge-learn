{
  "name": "@sprachweise/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run",
    "build:test": "WXT_TEST_MODE=true WXT_TEST_ORIGIN=http://127.0.0.1:58732 WXT_CMS_BASE_URL=http://127.0.0.1:58733 wxt build",
    "test:integration": "pnpm run build:test && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sprachweise/shared": "workspace:*",
    "idb": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wxt": "^0.21.3"
  }
}

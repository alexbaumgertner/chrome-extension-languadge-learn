{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@": ["."],
      "@/*": ["./*"],
      "~": ["."],
      "~/*": ["./*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "@sprachweise/shared": ["../../packages/shared/src/index.ts"],
      "@sprachweise/shared/*": ["../../packages/shared/src/*"]
    }
  }
}

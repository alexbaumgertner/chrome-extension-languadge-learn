# Copy to apps/cms/.env for local dev and scripts/quality-check.ts. Never commit .env.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_DAILY_REQUEST_ALLOWANCE=1500
# Postgres; `vercel env pull` from the repo root writes the Neon URL to .env.local
DATABASE_URL=
# Comma-separated, e.g. chrome-extension://<id>
CORS_ALLOWED_ORIGINS=
